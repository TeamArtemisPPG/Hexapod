# ==============================================================================
# NVIDIA NIM API Key Template
# Copy this file to .brain_secrets and fill in your actual API key:
#   cp .brain_secrets.example .brain_secrets
#
# Get your free NVIDIA NIM API key at: https://build.nvidia.com/
# .brain_secrets is excluded by .gitignore and will NEVER be committed.
# ==============================================================================
NVIDIA_API_KEY=nvapi-your_nvidia_nim_api_key_here
